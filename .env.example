# port the dev/prod server listens on
PORT=3000

# KEV System One — base URL; /v1/systemone is appended if missing.
# Hosted demo: https://yohann-60613--kev-demo.modal.run
KEV_ENDPOINT=
# bearer token (KEV_DEMO_KEY for the hosted demo; omit for local kev)
KEV_API_KEY=
# must match the served checkpoint — the demo serves kev-9b
KEV_MODEL=kev-9b
KEV_TIMEOUT_MS=30000

# telemetry poll interval
POLL_INTERVAL_MS=10000
