# port the dev/prod server and the watcher's self-poll target
PORT=3000

# KEV System One — base URL; /v1/systemone is appended if missing
KEV_ENDPOINT=
# optional bearer token; omit for unauthenticated local kev servers
KEV_API_KEY=
KEV_MODEL=kev-latest
KEV_TIMEOUT_MS=15000

# telemetry poll interval
POLL_INTERVAL_MS=10000
