+form label { display: block; margin-bottom: 10px; color: var(--muted); }
+input, textarea, select { width: 100%; margin-top: 4px; background: var(--bg); color: var(--text); border: 1px solid var(--border); border-radius: 6px; padding: 7px 9px; }
+menu { display: flex; justify-content: flex-end; gap: 8px; padding: 0; }
