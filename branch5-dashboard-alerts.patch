+++ b/server/test/server.test.js
@@ -0,0 +1,135 @@
+import { test, before, after } from 'node:test';
+import assert from 'node:assert/strict';
+import { createServer as httpServer } from 'node:http';
+import { createServer } from '../src/index.js';
+
+const T0 = Date.parse('2026-10-17T12:00:00.000Z');
+const ts = s => new Date(T0 + s * 1000).toISOString();
+let id = 0;
+const ev = (fp, s, o = {}) => ({
+  id: `e${++id}`, timestamp: ts(s), type: 'network_error', fingerprint: fp,
+  page: { url: 'https://shop.example.com/checkout' },
+  browser: o.browser ?? { name: 'Chrome', version: '141', os: 'macOS' },
+  error: { name: 'HTTPError', message: `HTTP ${o.status ?? 500}` },
+  request: { url: o.url ?? 'https://api.example.com/payments', method: 'POST', status: o.status ?? 500, transport: 'fetch' },
+});
+
+let server, store, base, webhook, webhookHits;
+
+before(async () => {
+  webhook = httpServer((req, res) => {
+    let body = '';
+    req.on('data', c => body += c);
+    req.on('end', () => { webhookHits.push(JSON.parse(body)); res.writeHead(200).end(); });
+  });
+  await new Promise(r => webhook.listen(0, '127.0.0.1', r));
+  webhookHits = [];
+  const webhookUrl = `http://127.0.0.1:${webhook.address().port}/hook`;
+
+  ({ server, store } = createServer({
+    publicUrl: 'http://overwatch.test',
+    triage: { serviceMap: [{ host: 'api.example.com', pathPrefix: '/payments', service: 'payments-api', team: 'payments' }], frontendOwner: { service: 'web-app', team: 'frontend' } },
+    notify: { slack: { url: webhookUrl }, routes: [{ team: 'payments', webhook: { url: webhookUrl, type: 'slack' } }], cooldownMs: 60_000, timeoutMs: 2000 },
+  }));
+  await new Promise(r => server.listen(0, '127.0.0.1', r));
+  base = `http://127.0.0.1:${server.address().port}`;
+});
+
+after(async () => {
+  server.close(); webhook.close(); store.flush?.();
+});
+
+const post = (path, body) => fetch(`${base}${path}`, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
+const get = path => fetch(`${base}${path}`).then(r => r.json());
+
+test('ingests an event envelope and creates an assessed incident', async () => {
+  const events = Array.from({ length: 24 }, (_, i) => ev('fp-pay', i < 6 ? i * 10 : 60 + i * 2));
+  const res = await post('/v1/events', { schemaVersion: 1, events });
+  assert.equal(res.status, 202);
+  const { incidents } = await res.json();
+  assert.equal(incidents.length, 1);
+
+  const { incident } = await get(`/api/incidents/${incidents[0]}`);
+  assert.equal(incident.status, 'active');
+  assert.equal(incident.severity.level, 'critical');
+  assert.equal(incident.assessment.ownership.service, 'payments-api');
+  assert.equal(incident.eventCount, 24);
+  assert.ok(incident.summary.includes('ESCALATE'));
+});
+
+test('sends a routed Slack notification for escalate/investigate incidents', async () => {
+  assert.ok(webhookHits.length >= 1, 'expected a webhook call');
+  const payload = webhookHits[0];
+  assert.ok(payload.text.includes('CRITICAL'));
+  assert.match(payload.blocks.at(-1).text.text, /overwatch\.test\/#incident-inc-/);
+});
+
+test('list endpoint filters by status', async () => {
+  const { incidents: active } = await get('/api/incidents?status=active');
+  assert.equal(active.length, 1);
+  const { incidents: resolved } = await get('/api/incidents?status=resolved');
+  assert.equal(resolved.length, 0);
+});
+
+test('acknowledge and resolve transitions appear in the timeline', async () => {
+  const { incidents } = await get('/api/incidents?status=active');
+  const id = incidents[0].id;
+
+  let res = await post(`/api/incidents/${id}/acknowledge`, { by: 'oncall-amy', note: 'looking' });
+  assert.equal(res.status, 200);
+  res = await post(`/api/incidents/${id}/acknowledge`, { by: 'x' });
+  assert.equal(res.status, 409);
+  res = await post(`/api/incidents/${id}/resolve`, { by: 'oncall-amy', note: 'rolled back deploy 4821' });
+  assert.equal(res.status, 200);
+
+  const { incident } = await get(`/api/incidents/${id}`);
+  assert.equal(incident.status, 'resolved');
+  assert.equal(incident.resolvedBy, 'oncall-amy');
+  assert.deepEqual(incident.timeline.map(t => t.kind).filter(k => ['acknowledged', 'resolved'].includes(k)), ['acknowledged', 'resolved']);
+});
+
+test('new matching events auto-reopen a resolved incident', async () => {
+  const { incidents } = await get('/api/incidents?status=resolved');
+  const id = incidents[0].id;
+  const res = await post('/v1/events', { schemaVersion: 1, events: [ev('fp-pay', 200)] });
+  assert.equal(res.status, 202);
+  const { incident } = await get(`/api/incidents/${id}`);
+  assert.equal(incident.status, 'active');
+  assert.ok(incident.timeline.some(t => t.kind === 'reopened'));
+});
+
+test('duplicate event IDs are deduped', async () => {
+  const before = store.match(['fp-pay']).events.length;
+  const e = ev('fp-pay', 210);
+  await post('/v1/events', { schemaVersion: 1, events: [e] });
+  await post('/v1/events', { schemaVersion: 1, events: [e] });
+  assert.equal(store.match(['fp-pay']).events.length, before + 1);
+});
+
+test('manual report creates an incident', async () => {
+  const res = await post('/api/reports', { title: 'Checkout button does nothing', description: 'Clicked pay 5 times, nothing happened', page: 'https://shop.example.com/checkout', reporter: 'sam', severity: 'high' });
+  assert.equal(res.status, 201);
+  const { incident } = await res.json();
+  assert.ok(incident.manual);
+  const { incident: full } = await get(`/api/incidents/${incident.id}`);
+  assert.equal(full.events[0].error.name, 'ManualReportCritical');
+  assert.equal(full.events[0].manual.reporter, 'sam');
+});
+
+test('manual report validates input', async () => {
+  const res = await post('/api/reports', { title: '', description: '' });
+  assert.equal(res.status, 400);
+});
+
+test('unknown incident and bad JSON are handled', async () => {
+  const res = await get('/api/incidents/inc-nope');
+  assert.equal(res.error, 'incident not found');
+  const bad = await fetch(`${base}/v1/events`, { method: 'POST', body: '{oops' });
+  assert.equal(bad.status, 400);
+});
+
+test('dashboard HTML is served at /', async () => {
+  const res = await fetch(`${base}/`);
+  assert.equal(res.status, 200);
+  assert.match(await res.text(), /Overwatch/);
+});
