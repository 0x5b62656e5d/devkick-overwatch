+</head>
+<body>
+<header>
+  <h1>Overwatch</h1>
+  <nav id="filters">
+    <button data-filter="open" class="active">Open</button>
+    <button data-filter="active">Active</button>
+    <button data-filter="acknowledged">Acknowledged</button>
+    <button data-filter="resolved">Resolved</button>
+    <button data-filter="all">All</button>
+  </nav>
+  <button id="new-report">+ Report issue</button>
+</header>
+
+<main id="incidents" aria-live="polite"></main>
+
+<dialog id="detail">
+  <article id="detail-body"></article>
+</dialog>
+
+<dialog id="report-form">
+  <form method="dialog" id="report">
+    <h2>Report a problem</h2>
+    <label>Title <input name="title" required maxlength="140"></label>
+    <label>Description <textarea name="description" required rows="4"></textarea></label>
+    <label>Page URL <input name="page" type="url" placeholder="https://…"></label>
+    <label>Severity hint
+      <select name="severity">
+        <option value="">let triage decide</option>
+        <option value="high">high</option>
+        <option value="critical">critical</option>
+      </select>
+    </label>
+    <label>Your name <input name="reporter" id="reporter-name" maxlength="80"></label>
+    <menu>
+      <button value="cancel" formnovalidate>Cancel</button>
+      <button id="report-submit" value="default">Submit report</button>
+    </menu>
+    <output id="report-result"></output>
+  </form>
+</dialog>
+
+<script src="/app.js" type="module"></script>
+</body>
+</html>
