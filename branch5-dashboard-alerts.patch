@@ -0,0 +1,151 @@
+const $ = selector => document.querySelector(selector);
+const state = { filter: 'open', incidents: [], detailId: location.hash.match(/incident-([\w-]+)/)?.[1] };
+
+const esc = s => String(s ?? '').replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
+const api = (path, options) => fetch(path, options && {
+  method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(options), ...options,
+});
+
+function statusParam() {
+  return state.filter === 'open' ? 'active,acknowledged' : state.filter;
+}
+
+function ago(iso) {
+  const s = Math.max(0, (Date.now() - Date.parse(iso)) / 1000);
+  if (s < 60) return `${Math.floor(s)}s ago`;
+  if (s < 3600) return `${Math.floor(s / 60)}m ago`;
+  if (s < 86400) return `${Math.floor(s / 3600)}h ago`;
+  return `${Math.floor(s / 86400)}d ago`;
+}
+
+function badge(text, cls) { return `<span class="badge ${cls}">${esc(text)}</span>`; }
+
+function renderList() {
+  const main = $('#incidents');
+  if (!state.incidents.length) {
+    main.innerHTML = '<p class="empty">No incidents here. Everything is quiet.</p>';
+    return;
+  }
+  main.innerHTML = state.incidents.map(i => `
+    <div class="card ${i.severity?.level ?? 'low'}" data-id="${i.id}">
+      <div class="row">
+        ${badge(i.severity?.level ?? '?', i.severity?.level ?? 'low')}
+        <span class="title">${esc(i.title)}</span>
+        ${badge(i.action?.recommendation ?? '', i.action?.recommendation ?? 'unknown')}
+        ${badge(i.status, `status-${i.status}`)}
+        ${i.action?.needsHumanIntervention ? '<span class="alert-banner">HUMAN INTERVENTION</span>' : ''}
+      </div>
+      <div class="row meta">
+        <span>${i.eventCount} events</span>
+        <span>last seen ${ago(i.lastSeen)}</span>
+        ${i.ownership?.service ? `<span>owner: ${esc(i.ownership.service)}${i.ownership.team ? ` (${esc(i.ownership.team)})` : ''}</span>` : ''}
+        ${i.affectedUsers?.status === 'estimated' ? `<span>~${i.affectedUsers.min}-${i.affectedUsers.max} users</span>` : ''}
+        ${i.manual ? '<span>manual report</span>' : ''}
+      </div>
+    </div>`).join('');
+  main.querySelectorAll('.card').forEach(card =>
+    card.addEventListener('click', () => openDetail(card.dataset.id)));
+}
+
+function assessBlock(title, body) {
+  return `<div><h4>${title}</h4>${body}</div>`;
+}
+
+async function openDetail(id) {
+  const { incident: i } = await (await fetch(`/api/incidents/${id}`)).json();
+  if (!i) return;
+  state.detailId = id;
+  history.replaceState(null, '', `#incident-${id}`);
+  const a = i.assessment ?? {};
+  const users = a.impact?.affectedUsers;
+  const canAct = i.status !== 'resolved';
+
+  $('#detail-body').innerHTML = `
+    <div class="row">
+      ${badge(a.severity?.level ?? '?', a.severity?.level ?? 'low')}
+      <h2 style="flex:1">${esc(i.title)}</h2>
+      <button data-close>Close</button>
+    </div>
+    ${a.action?.needsHumanIntervention ? '<p class="alert-banner">Immediate human intervention recommended.</p>' : ''}
+    <pre class="summary">${esc(a.summary ?? '')}</pre>
+    <section class="assess">
+      ${assessBlock('Severity', `${esc(a.severity?.level ?? 'unknown')} (score ${a.severity?.score ?? '?'}, ${esc(a.severity?.confidence ?? '?')} confidence)
+        <ul class="evidence">${(a.severity?.evidence ?? []).map(e => `<li>${esc(e)}</li>`).join('')}</ul>`)}
+      ${assessBlock('Affected users', users?.status === 'estimated'
+        ? `${users.min}-${users.max} (${esc(users.confidence)} confidence)<ul class="evidence">${(a.impact?.evidence ?? []).map(e => `<li>${esc(e)}</li>`).join('')}</ul>`
+        : `unknown — ${esc(users?.reason ?? '')}`)}
+      ${assessBlock('Likely owner', a.ownership?.status === 'identified'
+        ? `${esc(a.ownership.service)}${a.ownership.team ? ` / ${esc(a.ownership.team)}` : ''} (${esc(a.ownership.confidence)})<ul class="evidence">${(a.ownership.evidence ?? []).map(e => `<li>${esc(e)}</li>`).join('')}</ul>`
+        : `unknown — ${esc(a.ownership?.reason ?? '')}`)}
+      ${assessBlock('Verification / action', `${esc(a.action?.recommendation ?? 'unknown')} — ${esc(a.action?.rationale ?? '')}
+        <ul class="evidence">${(a.action?.evidence ?? []).map(e => `<li>${esc(e)}</li>`).join('')}</ul>`)}
+    </section>
+    <section class="row">
+      ${i.status === 'active' ? '<button data-act="acknowledge">Acknowledge</button>' : ''}
+      ${canAct ? '<button data-act="resolve">Resolve</button>' : '<button data-act="reopen">Reopen</button>'}
+      <span class="meta">${i.acknowledgedBy ? `ack by ${esc(i.acknowledgedBy)} · ` : ''}${i.resolvedBy ? `resolved by ${esc(i.resolvedBy)}${i.resolutionNote ? `: ${esc(i.resolutionNote)}` : ''}` : ''}</span>
+    </section>
+    <section>
+      <h3>Timeline</h3>
+      <ul class="timeline">${i.timeline.map(t =>
+        `<li><span class="kind">${esc(t.kind)}</span> <span class="meta">${ago(t.at)}</span><br>${esc(t.detail)}</li>`).join('')}</ul>
+    </section>
+    <section>
+      <h3>Latest events${i.truncatedEvents ? ` (showing ${i.events.length} of ${i.eventCount + 0})` : ''}</h3>
+      <table class="events"><tr><th>time</th><th>type</th><th>error</th><th>request</th></tr>
+      ${i.events.slice(-20).reverse().map(e => `<tr>
+        <td class="meta">${new Date(e.timestamp).toLocaleTimeString()}</td>
+        <td>${esc(e.type)}</td>
+        <td>${esc(`${e.error?.name ?? ''} ${e.error?.message ?? ''}`.slice(0, 90))}</td>
+        <td class="meta">${e.request ? esc(`${e.request.status ?? ''} ${e.request.url?.slice(0, 60) ?? ''}`) : ''}</td>
+      </tr>`).join('')}</table>
+    </section>`;
+
+  $('#detail-body [data-close]').onclick = () => $('#detail').close();
+  $('#detail-body').querySelectorAll('[data-act]').forEach(btn => btn.onclick = async () => {
+    const by = localStorage.overwatchUser ??= prompt('Your name?') ?? 'anonymous';
+    let note;
+    if (btn.dataset.act === 'resolve') note = prompt('Resolution note (optional)') ?? undefined;
+    await api(`/api/incidents/${id}/${btn.dataset.act}`, { by, note });
+    $('#detail').close();
+    refresh();
+  });
+  $('#detail').onclose = () => history.replaceState(null, '', '/');
+  $('#detail').showModal();
+}
+
+async function refresh() {
+  try {
+    const { incidents } = await (await fetch(`/api/incidents?status=${statusParam()}`)).json();
+    state.incidents = incidents;
+    renderList();
+  } catch { /* keep last render */ }
+}
+
+$('#filters').addEventListener('click', e => {
+  const btn = e.target.closest('button');
+  if (!btn) return;
+  state.filter = btn.dataset.filter;
+  $('#filters').querySelectorAll('button').forEach(b => b.classList.toggle('active', b === btn));
+  refresh();
+});
+
+$('#new-report').onclick = () => { $('#report-result').value = ''; $('#report-form').showModal(); };
+$('#reporter-name').value = localStorage.overwatchUser ?? '';
+$('#report').addEventListener('submit', async e => {
+  if (e.submitter?.value === 'cancel') return;
+  e.preventDefault();
+  const data = Object.fromEntries(new FormData(e.target));
+  localStorage.overwatchUser = data.reporter || '';
+  const res = await api('/api/reports', data);
+  const out = $('#report-result');
+  if (res.ok) {
+    const { incident } = await res.json();
+    out.value = `Report filed as incident ${incident?.id ?? ''} (${incident?.severity?.level ?? '?'})`;
+    refresh();
+  } else out.value = `Failed: ${(await res.json()).error}`;
+});
+
+refresh();
+setInterval(refresh, 10000);
+if (state.detailId) openDetail(state.detailId).catch(() => {});
