diff --git a/server/src/api.js b/server/src/api.js
new file mode 100644
index 0000000..155682a
--- /dev/null
+++ b/server/src/api.js
@@ -0,0 +1,154 @@
+import { ingestBatch } from './ingest.js';
+import { manualReportEvent, notifyIncident } from './notify.js';
+
+const MAX_BODY = 256 * 1024;
+
+function readBody(request) {
+  return new Promise((resolve, reject) => {
+    const chunks = [];
+    let size = 0;
+    request.on('data', chunk => {
+      size += chunk.length;
+      if (size > MAX_BODY) { reject(Object.assign(new Error('payload too large'), { status: 413 })); request.destroy(); return; }
+      chunks.push(chunk);
+    });
+    request.on('end', () => resolve(Buffer.concat(chunks).toString('utf8')));
+    request.on('error', reject);
+  });
+}
+
+function json(response, status, data) {
+  response.writeHead(status, { 'Content-Type': 'application/json', 'Cache-Control': 'no-store' });
+  response.end(JSON.stringify(data));
+}
+
+function summarize(incident) {
+  const a = incident.assessment ?? {};
+  return {
+    id: incident.id,
+    title: incident.title,
+    status: incident.status,
+    severity: a.severity && { level: a.severity.level, confidence: a.severity.confidence, trend: a.severity.trend },
+    action: a.action,
+    ownership: a.ownership,
+    affectedUsers: a.impact?.affectedUsers,
+    eventCount: incident.events.length,
+    fingerprints: incident.fingerprints,
+    firstSeen: incident.firstSeen,
+    lastSeen: incident.lastSeen,
+    summary: incident.assessment?.summary,
+    manual: incident.manual,
+    acknowledgedBy: incident.acknowledgedBy,
+    resolvedBy: incident.resolvedBy,
+  };
+}
+
+function detail(incident) {
+  return {
+    ...summarize(incident),
+    assessment: incident.assessment,
+    timeline: incident.timeline,
+    notifications: incident.notifications,
+    acknowledgedAt: incident.acknowledgedAt,
+    resolvedAt: incident.resolvedAt,
+    resolutionNote: incident.resolutionNote,
+    events: incident.events.slice(-100),
+    truncatedEvents: Math.max(0, incident.events.length - 100),
+  };
+}
+
+async function afterIngest(touched, config, store) {
+  for (const { incident } of touched) {
+    await notifyIncident(incident, config, (inc, kind, text) => store.log(inc, kind, text)).catch(() => {});
+  }
+}
+
+/**
+ * Route table for the HTTP server. Returns true when the request was handled.
+ */
+export function createApi({ store, config }) {
+  const routes = [
+    ['POST', /^\/v1\/events$/, async (req, res) => {
+      const body = JSON.parse(await readBody(req));
+      const { triageResult, touched } = await ingestBatch(store, body, config);
+      await afterIngest(touched, config, store);
+      json(res, 202, {
+        accepted: triageResult.eventCount,
+        dropped: triageResult.droppedEvents,
+        incidents: touched.map(t => t.incident.id),
+      });
+    }],
+
+    ['GET', /^\/api\/health$/, async (req, res) => {
+      json(res, 200, { ok: true, incidents: store.incidents.size });
+    }],
+
+    ['GET', /^\/api\/incidents$/, async (req, res, url) => {
+      const status = url.searchParams.get('status') ?? 'active,acknowledged';
+      const wanted = status === 'all' ? undefined : status.split(',');
+      const list = wanted ? wanted.flatMap(s => store.list(s)) : store.list('all');
+      json(res, 200, { incidents: list.map(summarize) });
+    }],
+
+    ['GET', /^\/api\/incidents\/([\w-]+)$/, async (req, res, url, m) => {
+      const incident = store.get(m[1]);
+      if (!incident) return json(res, 404, { error: 'incident not found' });
+      json(res, 200, { incident: detail(incident) });
+    }],
+
+    ['POST', /^\/api\/incidents\/([\w-]+)\/(acknowledge|resolve|reopen)$/, async (req, res, url, m) => {
+      const incident = store.get(m[1]);
+      if (!incident) return json(res, 404, { error: 'incident not found' });
+      const body = JSON.parse(await readBody(req) || '{}');
+      const by = String(body.by || 'anonymous').slice(0, 128);
+      const now = new Date().toISOString();
+
+      if (m[2] === 'acknowledge') {
+        if (incident.status !== 'active') return json(res, 409, { error: `cannot acknowledge a ${incident.status} incident` });
+        incident.status = 'acknowledged';
+        incident.acknowledgedAt = now;
+        incident.acknowledgedBy = by;
+        store.log(incident, 'acknowledged', `acknowledged by ${by}${body.note ? `: ${body.note}` : ''}`);
+      } else if (m[2] === 'resolve') {
+        if (incident.status === 'resolved') return json(res, 409, { error: 'incident already resolved' });
+        incident.status = 'resolved';
+        incident.resolvedAt = now;
+        incident.resolvedBy = by;
+        incident.resolutionNote = typeof body.note === 'string' ? body.note.slice(0, 500) : undefined;
+        store.log(incident, 'resolved', `resolved by ${by}${incident.resolutionNote ? `: ${incident.resolutionNote}` : ''}`);
+      } else {
+        if (incident.status !== 'resolved') return json(res, 409, { error: 'only resolved incidents can be reopened' });
+        incident.status = 'active';
+        incident.resolvedAt = incident.resolvedBy = incident.resolutionNote = undefined;
+        store.log(incident, 'reopened', `reopened by ${by}`);
+      }
+      json(res, 200, { incident: summarize(incident) });
+    }],
+
+    ['POST', /^\/api\/reports$/, async (req, res) => {
+      const body = JSON.parse(await readBody(req));
+      const event = manualReportEvent(body);
+      const { touched } = await ingestBatch(store, { schemaVersion: 1, events: [event] }, config);
+      await afterIngest(touched, config, store);
+      const incident = touched[0]?.incident;
+      json(res, 201, { incidentId: incident?.id, incident: incident && summarize(incident) });
+    }],
+  ];
+
+  return async function handle(request, response, url) {
+    for (const [method, pattern, handler] of routes) {
+      if (request.method !== method) continue;
+      const m = url.pathname.match(pattern);
+      if (!m) continue;
+      try {
+        await handler(request, response, url, m);
+      } catch (error) {
+        const status = error.status ?? (error instanceof SyntaxError || error instanceof TypeError ? 400 : 500);
+        json(response, status, { error: status === 500 ? 'internal error' : error.message });
+        if (status === 500) console.error('[overwatch]', error);
+      }
+      return true;
+    }
+    return false;
+  };
+}
diff --git a/server/src/config.js b/server/src/config.js
new file mode 100644
index 0000000..a600076
--- /dev/null
+++ b/server/src/config.js
@@ -0,0 +1,29 @@
+import { readFileSync } from 'node:fs';
+
+/**
+ * Config precedence: defaults < JSON config file < environment variables.
+ * Env vars: OVERWATCH_PORT, OVERWATCH_PUBLIC_URL, OVERWATCH_STORE,
+ *           SLACK_WEBHOOK_URL, DISCORD_WEBHOOK_URL
+ */
+export function loadConfig(configPath) {
+  const file = configPath ? JSON.parse(readFileSync(configPath, 'utf8')) : {};
+  return {
+    port: Number(process.env.OVERWATCH_PORT ?? file.port ?? 8090),
+    publicUrl: process.env.OVERWATCH_PUBLIC_URL ?? file.publicUrl,
+    storePath: process.env.OVERWATCH_STORE ?? file.storePath,
+    triage: file.triage?.criticalPaths
+      // JSON config can only carry strings; compile path patterns to RegExp.
+      ? { ...file.triage, criticalPaths: file.triage.criticalPaths.map(p => p instanceof RegExp ? p : new RegExp(p, 'i')) }
+      : (file.triage ?? {}),
+    notify: {
+      // Global defaults; per-team routes below override them.
+      slack: process.env.SLACK_WEBHOOK_URL ? { url: process.env.SLACK_WEBHOOK_URL } : file.notify?.slack,
+      discord: process.env.DISCORD_WEBHOOK_URL ? { url: process.env.DISCORD_WEBHOOK_URL } : file.notify?.discord,
+      routes: file.notify?.routes ?? [],
+      cooldownMs: file.notify?.cooldownMs ?? 30 * 60 * 1000,
+      // observe-level incidents only notify when this is true
+      notifyObserved: file.notify?.notifyObserved ?? false,
+      timeoutMs: file.notify?.timeoutMs ?? 5000,
+    },
+  };
+}
diff --git a/server/src/index.js b/server/src/index.js
new file mode 100644
index 0000000..ae30df8
--- /dev/null
+++ b/server/src/index.js
@@ -0,0 +1,56 @@
+import { createServer as httpServer } from 'node:http';
+import { readFile } from 'node:fs/promises';
+import { fileURLToPath } from 'node:url';
+import { join, extname, normalize } from 'node:path';
+import { loadConfig } from './config.js';
+import { IncidentStore } from './store.js';
+import { createApi } from './api.js';
+
+const PUBLIC = fileURLToPath(new URL('../public', import.meta.url));
+const MIME = { '.html': 'text/html', '.js': 'text/javascript', '.css': 'text/css', '.svg': 'image/svg+xml' };
+
+export function createServer(config) {
+  const store = new IncidentStore({ storePath: config.storePath });
+  const api = createApi({ store, config });
+
+  const server = httpServer(async (request, response) => {
+    const url = new URL(request.url, 'http://localhost');
+    if (await api(request, response, url)) return;
+
+    if (request.method === 'GET') {
+      const path = url.pathname === '/' ? '/index.html' : url.pathname;
+      const file = normalize(join(PUBLIC, path));
+      if (file.startsWith(PUBLIC)) {
+        try {
+          const body = await readFile(file);
+          response.writeHead(200, { 'Content-Type': MIME[extname(file)] ?? 'application/octet-stream' });
+          return response.end(body);
+        } catch { /* fall through to 404 */ }
+      }
+    }
+    response.writeHead(404, { 'Content-Type': 'application/json' });
+    response.end(JSON.stringify({ error: 'not found' }));
+  });
+
+  return { server, store };
+}
+
+export async function start(configPath) {
+  const config = loadConfig(configPath);
+  const { server, store } = createServer(config);
+  await new Promise(resolve => server.listen(config.port, resolve));
+  const { port } = server.address();
+  console.log(`[overwatch] dashboard: http://localhost:${port}`);
+  console.log(`[overwatch] ingestion: POST http://localhost:${port}/v1/events`);
+  const webhooks = [config.notify.slack, config.notify.discord, ...(config.notify.routes ?? []).map(r => r.webhook ?? r.slack ?? r.discord)].filter(Boolean);
+  console.log(`[overwatch] notifications: ${webhooks.length ? `${webhooks.length} webhook target(s)` : 'no webhooks configured'}`);
+  return { server, store, config };
+}
+
+const isMain = process.argv[1] === fileURLToPath(import.meta.url);
+if (isMain) {
+  const args = process.argv.slice(2);
+  const configPath = args.includes('--config') ? args[args.indexOf('--config') + 1] : undefined;
+  if (args.includes('--port')) process.env.OVERWATCH_PORT = args[args.indexOf('--port') + 1];
+  start(configPath).catch(error => { console.error(error); process.exit(1); });
+}
diff --git a/server/src/ingest.js b/server/src/ingest.js
new file mode 100644
index 0000000..af6d2fd
--- /dev/null
+++ b/server/src/ingest.js
@@ -0,0 +1,71 @@
+import { triage } from '../../triage/src/index.js';
+
+function assessmentFor(triageResult, fingerprints) {
+  if (triageResult.incidents.length === 1) return triageResult.incidents[0];
+  // Re-triaging a merged event set may split it; keep the assessment that
+  // shares the most fingerprints with this stored incident.
+  return triageResult.incidents
+    .map(incident => ({
+      incident,
+      overlap: incident.fingerprints.filter(fp => fingerprints.includes(fp)).length,
+    }))
+    .sort((a, b) => b.overlap - a.overlap || b.incident.eventCount - a.incident.eventCount)[0].incident;
+}
+
+function applyAssessment(incident, assessment, store) {
+  const previous = incident.assessment?.severity?.level;
+  incident.assessment = assessment;
+  incident.title = assessment.title;
+  incident.severity = assessment.severity;
+  incident.firstSeen = assessment.firstSeen;
+  incident.manual = incident.manual || assessment.events.some(e => e.manual);
+  if (previous && previous !== assessment.severity.level) {
+    store.log(incident, 'assessment', `severity changed ${previous} -> ${assessment.severity.level}`);
+  }
+}
+
+/**
+ * Triages a batch of events and folds the resulting incidents into the store:
+ * fingerprint matches merge into existing incidents (resolved incidents
+ * auto-reopen), unmatched fingerprints create new ones.
+ */
+export function ingestBatch(store, input, config = {}) {
+  const result = triage(input, { now: Date.now(), ...config.triage });
+  const touched = [];
+
+  for (const assessed of result.incidents) {
+    const existing = store.match(assessed.fingerprints);
+    if (!existing) {
+      const incident = store.create({
+        fingerprints: [...assessed.fingerprints],
+        events: [],
+        firstSeen: assessed.firstSeen,
+        lastSeen: assessed.lastSeen,
+      });
+      store.merge(incident, assessed.events, assessed.fingerprints);
+      applyAssessment(incident, assessed, store);
+      store.log(incident, 'detected', `incident detected from ${assessed.eventCount} event(s)`);
+      touched.push({ incident, isNew: true, previousRecommendation: null });
+      continue;
+    }
+
+    const previousRecommendation = existing.assessment?.action?.recommendation ?? null;
+    const added = store.merge(existing, assessed.events, assessed.fingerprints);
+    if (added === 0) continue;
+    store.log(existing, 'events', `${added} new event(s)`);
+
+    // Re-assess against the incident's full event history so severity and
+    // trend reflect accumulated evidence, not just the latest batch.
+    const reassessed = triage(existing.events, { now: Date.now(), ...config.triage });
+    applyAssessment(existing, assessmentFor(reassessed, existing.fingerprints), store);
+
+    if (existing.status === 'resolved') {
+      existing.status = 'active';
+      existing.resolvedAt = existing.resolvedBy = existing.resolutionNote = undefined;
+      store.log(existing, 'reopened', 'new matching errors after resolution');
+    }
+    touched.push({ incident: existing, isNew: false, previousRecommendation });
+  }
+
+  return { triageResult: result, touched };
+}
diff --git a/server/src/notify.js b/server/src/notify.js
new file mode 100644
index 0000000..cc1066c
--- /dev/null
+++ b/server/src/notify.js
@@ -0,0 +1,146 @@
+import { randomUUID } from 'node:crypto';
+
+function hash(text) {
+  let h = 0x811c9dc5;
+  for (let i = 0; i < text.length; i++) h = Math.imul(h ^ text.charCodeAt(i), 0x01000193);
+  return (h >>> 0).toString(16).padStart(8, '0');
+}
+
+/** Build a synthetic schema-v1 event from the manual report form. */
+export function manualReportEvent({ title, description, page, reporter, severity }) {
+  if (typeof title !== 'string' || !title.trim()) throw new TypeError('title is required');
+  if (typeof description !== 'string' || !description.trim()) throw new TypeError('description is required');
+  return {
+    id: `manual-${randomUUID()}`,
+    timestamp: new Date().toISOString(),
+    type: 'javascript_error',
+    fingerprint: `manual-${hash(title.trim().toLowerCase())}`,
+    page: { url: typeof page === 'string' && page ? page : 'manual://report' },
+    browser: { name: 'unknown', version: '', os: 'unknown' },
+    error: {
+      name: severity && ['critical', 'high'].includes(severity) ? 'ManualReportCritical' : 'ManualReport',
+      message: `${title.trim()}: ${description.trim()}`.slice(0, 1024),
+    },
+    manual: { reporter: String(reporter || 'anonymous').slice(0, 128) },
+    source: { url: page || 'manual://report', line: 0, column: 0 },
+  };
+}
+
+function webhookType(target) {
+  if (target.type) return target.type;
+  return /discord(?:app)?\.com/.test(target.url) ? 'discord' : 'slack';
+}
+
+function link(config, incident) {
+  const base = config.publicUrl ?? 'http://localhost:8090';
+  return `${base}/#incident-${incident.id}`;
+}
+
+function slackPayload(incident, config, urgent) {
+  const a = incident.assessment;
+  const owner = a.ownership.status === 'identified'
+    ? `${a.ownership.service}${a.ownership.team ? ` (${a.ownership.team})` : ''}` : 'unknown';
+  const users = a.impact.affectedUsers.status === 'estimated'
+    ? `${a.impact.affectedUsers.min}-${a.impact.affectedUsers.max}` : 'unknown';
+  const text = `${urgent ? ':rotating_light: ' : ''}*${a.severity.level.toUpperCase()}* ${incident.title}`;
+  return {
+    text,
+    blocks: [
+      { type: 'section', text: { type: 'mrkdwn', text } },
+      { type: 'section', fields: [
+        { type: 'mrkdwn', text: `*Events:*\n${incident.events.length}` },
+        { type: 'mrkdwn', text: `*Affected users:*\n${users}` },
+        { type: 'mrkdwn', text: `*Owner:*\n${owner}` },
+        { type: 'mrkdwn', text: `*Action:*\n${a.action.recommendation}${a.action.needsHumanIntervention ? ' — human needed' : ''}` },
+      ] },
+      { type: 'section', text: { type: 'mrkdwn', text: `<${link(config, incident)}|Open in Overwatch>` } },
+    ],
+  };
+}
+
+function discordPayload(incident, config, urgent) {
+  const a = incident.assessment;
+  const colors = { critical: 0xdc2626, high: 0xea580c, medium: 0xca8a04, low: 0x6b7280, unknown: 0x6b7280 };
+  const owner = a.ownership.status === 'identified'
+    ? `${a.ownership.service}${a.ownership.team ? ` (${a.ownership.team})` : ''}` : 'unknown';
+  const users = a.impact.affectedUsers.status === 'estimated'
+    ? `${a.impact.affectedUsers.min}-${a.impact.affectedUsers.max}` : 'unknown';
+  return {
+    content: urgent ? `@here **${a.severity.level.toUpperCase()}** incident needs human intervention` : undefined,
+    embeds: [{
+      title: `[${a.severity.level.toUpperCase()}] ${incident.title}`.slice(0, 256),
+      url: link(config, incident),
+      color: colors[a.severity.level] ?? colors.unknown,
+      fields: [
+        { name: 'Events', value: String(incident.events.length), inline: true },
+        { name: 'Affected users', value: users, inline: true },
+        { name: 'Owner', value: owner, inline: true },
+        { name: 'Action', value: a.action.recommendation.toUpperCase(), inline: true },
+      ],
+    }],
+  };
+}
+
+function routeFor(incident, notify) {
+  const team = incident.assessment?.ownership?.team;
+  const service = incident.assessment?.ownership?.service;
+  const route = (notify.routes ?? []).find(r =>
+    (r.team && r.team === team) || (r.service && r.service === service));
+  const target = route?.webhook ?? route?.slack ?? route?.discord;
+  if (target) return typeof target === 'string' ? { url: target } : target;
+  return notify.slack ?? notify.discord ?? null;
+}
+
+export function shouldNotify(incident, notify) {
+  const rec = incident.assessment?.action?.recommendation;
+  if (!['escalate', 'investigate'].includes(rec) && !(rec === 'observe' && notify.notifyObserved)) return false;
+  const now = Date.now();
+  const last = [...(incident.notifications ?? [])].at(-1);
+  if (last && now - Date.parse(last.at) < (notify.cooldownMs ?? 1800000)
+      && last.recommendation === rec) return false;
+  return true;
+}
+
+/**
+ * Sends a Slack/Discord webhook notification routed by owning team/service.
+ * Records the attempt on the incident; returns {sent, reason?}.
+ */
+export async function notifyIncident(incident, config, log) {
+  const notify = config.notify ?? {};
+  if (!shouldNotify(incident, notify)) return { sent: false, reason: 'suppressed' };
+  const target = routeFor(incident, notify);
+  if (!target?.url) return { sent: false, reason: 'no-webhook' };
+
+  const urgent = incident.assessment.action.needsHumanIntervention;
+  const payload = webhookType(target) === 'discord'
+    ? discordPayload(incident, config, urgent)
+    : slackPayload(incident, config, urgent);
+
+  const controller = new AbortController();
+  const timer = setTimeout(() => controller.abort(), notify.timeoutMs ?? 5000);
+  let ok = false, detail = '';
+  try {
+    const response = await fetch(target.url, {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify(payload),
+      signal: controller.signal,
+    });
+    ok = response.ok;
+    detail = `HTTP ${response.status}`;
+  } catch (error) {
+    detail = error.name === 'AbortError' ? 'timeout' : error.message;
+  } finally {
+    clearTimeout(timer);
+  }
+
+  incident.notifications.push({
+    at: new Date().toISOString(),
+    channel: webhookType(target),
+    team: incident.assessment?.ownership?.team ?? null,
+    recommendation: incident.assessment.action.recommendation,
+    ok, detail,
+  });
+  log?.(incident, 'notification', `${ok ? 'sent' : 'FAILED'} via ${webhookType(target)} (${detail})`);
+  return { sent: ok, reason: ok ? undefined : detail };
+}
