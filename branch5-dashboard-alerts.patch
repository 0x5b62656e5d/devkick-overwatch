+import { test, expect } from '@playwright/test';
+
+const T0 = Date.parse('2026-10-17T12:00:00.000Z');
+const ev = i => ({
+  id: `e2e-${i}`, timestamp: new Date(T0 + i * 1000).toISOString(),
+  type: 'network_error', fingerprint: 'fp-e2e',
+  page: { url: 'https://shop.example.com/checkout' },
+  browser: { name: 'Chrome', version: '141', os: 'macOS' },
+  error: { name: 'HTTPError', message: 'HTTP 500' },
+  request: { url: 'https://api.example.com/payments', method: 'POST', status: 500, transport: 'fetch' },
+});
+
+test('dashboard lists a seeded incident and shows its report', async ({ page, request }) => {
+  const res = await request.post('/v1/events', {
+    data: { schemaVersion: 1, events: Array.from({ length: 24 }, (_, i) => ev(i)) },
+  });
+  expect(res.status()).toBe(202);
+
+  await page.goto('/');
+  await expect(page.locator('.card')).toHaveCount(1);
+  await expect(page.locator('.card .title')).toContainText('api.example.com/payments');
+  await expect(page.locator('.card .badge.critical')).toHaveText('critical');
+
+  await page.locator('.card').click();
+  const dialog = page.locator('#detail');
+  await expect(dialog.locator('pre.summary')).toContainText('ESCALATE');
+  await expect(dialog.locator('.timeline li').first()).toContainText('detected');
+  await expect(dialog.locator('section.assess')).toContainText('Affected users');
+
+  page.once('dialog', d => d.accept('e2e-tester'));
+  await dialog.locator('[data-act="acknowledge"]').click();
+  await page.locator('nav #filters [data-filter="acknowledged"], nav button[data-filter="acknowledged"]').click();
+  await expect(page.locator('.card .badge.status-acknowledged')).toHaveText('acknowledged');
+});
+
+test('manual report form files an incident', async ({ page }) => {
+  await page.goto('/');
+  await page.locator('#new-report').click();
+  await page.locator('input[name="title"]').fill('E2E: login page blank');
+  await page.locator('textarea[name="description"]').fill('White screen after submitting credentials');
+  await page.locator('input[name="page"]').fill('https://shop.example.com/login');
+  await page.locator('#report-submit').click();
+  await expect(page.locator('#report-result')).toContainText('incident inc-');
+});
