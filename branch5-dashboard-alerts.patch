index 0000000..3cec044
--- /dev/null
+++ b/server/src/store.js
@@ -0,0 +1,116 @@
+import { readFileSync, writeFileSync, renameSync, existsSync } from 'node:fs';
+import { randomUUID } from 'node:crypto';
+
+const SEVERITY_RANK = { critical: 4, high: 3, medium: 2, low: 1, unknown: 0 };
+
+/**
+ * In-memory incident store with optional JSON file persistence. Incidents are
+ * matched to incoming events by fingerprint; event IDs dedupe delivery retries.
+ */
+export class IncidentStore {
+  constructor({ storePath } = {}) {
+    this.storePath = storePath;
+    this.incidents = new Map();
+    this.eventIds = new Set();
+    this.byFingerprint = new Map();
+    this.persistTimer = undefined;
+    if (storePath && existsSync(storePath)) {
+      try {
+        const data = JSON.parse(readFileSync(storePath, 'utf8'));
+        for (const incident of data.incidents ?? []) this._index(incident);
+      } catch (error) {
+        console.error(`[overwatch] could not load store ${storePath}: ${error.message}`);
+      }
+    }
+  }
+
+  _index(incident) {
+    this.incidents.set(incident.id, incident);
+    for (const fp of incident.fingerprints) this.byFingerprint.set(fp, incident.id);
+    for (const event of incident.events) this.eventIds.add(event.id);
+  }
+
+  match(fingerprints) {
+    for (const fp of fingerprints) {
+      const id = this.byFingerprint.get(fp);
+      if (id) return this.incidents.get(id);
+    }
+    return undefined;
+  }
+
+  create(fields) {
+    const incident = {
+      id: `inc-${randomUUID().slice(0, 8)}`,
+      status: 'active',
+      createdAt: new Date().toISOString(),
+      timeline: [],
+      notifications: [],
+      manual: false,
+      ...fields,
+    };
+    this._index(incident);
+    this._dirty();
+    return incident;
+  }
+
+  /** Append events (deduped by id) and re-index any new fingerprints. */
+  merge(incident, events, fingerprints) {
+    let added = 0;
+    for (const event of events) {
+      if (this.eventIds.has(event.id)) continue;
+      this.eventIds.add(event.id);
+      incident.events.push(event);
+      added++;
+    }
+    for (const fp of fingerprints) {
+      if (!incident.fingerprints.includes(fp)) {
+        incident.fingerprints.push(fp);
+        this.byFingerprint.set(fp, incident.id);
+      }
+    }
+    incident.events.sort((a, b) => Date.parse(a.timestamp) - Date.parse(b.timestamp));
+    incident.updatedAt = new Date().toISOString();
+    incident.lastSeen = incident.events.at(-1)?.timestamp ?? incident.lastSeen;
+    this._dirty();
+    return added;
+  }
+
+  log(incident, kind, detail) {
+    incident.timeline.push({ at: new Date().toISOString(), kind, detail });
+    if (incident.timeline.length > 500) incident.timeline.splice(0, incident.timeline.length - 500);
+    this._dirty();
+  }
+
+  list(status) {
+    const all = [...this.incidents.values()];
+    const filtered = status && status !== 'all' ? all.filter(i => i.status === status) : all;
+    return filtered.sort((a, b) =>
+      (SEVERITY_RANK[b.severity?.level] ?? 0) - (SEVERITY_RANK[a.severity?.level] ?? 0) ||
+      Date.parse(b.lastSeen) - Date.parse(a.lastSeen));
+  }
+
+  get(id) { return this.incidents.get(id); }
+
+  _dirty() {
+    if (!this.storePath || this.persistTimer) return;
+    this.persistTimer = setTimeout(() => {
+      this.persistTimer = undefined;
+      try {
+        const tmp = `${this.storePath}.tmp`;
+        writeFileSync(tmp, JSON.stringify({ incidents: [...this.incidents.values()] }));
+        renameSync(tmp, this.storePath);
+      } catch (error) {
+        console.error(`[overwatch] persist failed: ${error.message}`);
+      }
+    }, 250);
+  }
+
+  flush() {
+    if (this.persistTimer) { clearTimeout(this.persistTimer); this.persistTimer = undefined; }
+    if (this.storePath) {
+      const tmp = `${this.storePath}.tmp`;
+      writeFileSync(tmp, JSON.stringify({ incidents: [...this.incidents.values()] }));
+      renameSync(tmp, this.storePath);
+    }
+  }
+}
diff --git a/server/test/server.test.js b/server/test/server.test.js
